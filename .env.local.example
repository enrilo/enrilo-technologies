# Copy this file to .env.local and fill in your real Google Analytics 4 Measurement ID
# Find it in GA4: Admin > Data Streams > (your stream) > Measurement ID (starts with "G-")
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- Book a Walkthrough: Zoho Meeting (server-only, never prefix with NEXT_PUBLIC_) ----
# See lib/zohoMeeting.js for how to generate these via https://api-console.zoho.in -> Self Client
# Scopes: ZohoMeeting.meeting.ALL,ZohoMeeting.manageOrg.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=in
ZOHO_MEETING_ZSOID=
# Optional: your zuid (from /api/v2/user.json) — saves one API call per booking
ZOHO_PRESENTER_ZUID=

# ---- Book a Walkthrough: confirmation email (SMTP) ----
# Zoho Mail: host smtp.zoho.in, port 465, use an app-specific password
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Enrilo Technologies <contactus@enrilotechnologies.com>"
# Optional: get a "new booking" email with the visitor's message
BOOKING_NOTIFY_EMAIL=
# Set to false if Zoho's own invite email is enough and you don't want a second email
SEND_BOOKING_EMAIL=true
